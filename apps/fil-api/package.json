{
  "name": "fil-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloudflare Worker REST API and MCP server for Filecoin onchain data",
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "typecheck": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@filoz/synapse-core": "0.10.0",
    "@hono/mcp": "0.3.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@scalar/hono-api-reference": "0.12.6",
    "hono": "4.13.12",
    "multiformats": "14.0.5",
    "postgres": "3.4.9",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
