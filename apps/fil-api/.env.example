# Copy to .env (gitignored). Wrangler reads these when running `wrangler dev`
# and needs one per Hyperdrive binding in wrangler.jsonc.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CALIBRATION="postgresql://user:password@host:5432/indexers"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_MAINNET="postgresql://user:password@host:5432/indexers"
