{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fil-app",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start renders pages in the Worker; the Cloudflare Vite plugin
  // serves the client build as static assets.
  "main": "@tanstack/react-start/server-entry",
  "routes": [{ "pattern": "fil-app.hugomrdias.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`; the app needs no preview bindings.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {},
  "observability": { "enabled": true }
}
