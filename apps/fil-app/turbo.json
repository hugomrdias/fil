{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/fil-cli/skills/**"],
      "outputs": ["dist/**"]
    },
    "deploy": {
      "dependsOn": ["^build", "build", "typecheck", "test", "lint"]
    }
  }
}
