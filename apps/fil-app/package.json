{
  "name": "fil-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Filecoin explorer and wallet dashboard",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "gen:api": "pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9.3 openapi-typescript ${FIL_API_URL:-https://fil-api.hugomrdias.dev}/openapi.json -o src/lib/api/schema.d.ts",
    "deploy": "wrangler deploy",
    "cf-preview": "wrangler preview",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@filoz/synapse-core": "0.10.0",
    "@filoz/synapse-react": "0.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "9.2.4",
    "@wagmi/core": "3.6.5",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.49.0",
    "marked": "18.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "viem": "2.57.2",
    "wagmi": "3.7.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.2",
    "@hugomrdias/vite-plugin-agent-skills": "workspace:*",
    "wrangler": "4.147.0"
  }
}
